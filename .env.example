# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Written by scripts/provision_cluster.sh after `ccloud cluster create`.
CAIRN_DATABASE_URL=postgresql://cairn_app:PASSWORD@HOST:26257/cairn?sslmode=verify-full

# CockroachDB Cloud cluster identity (used by `cairn doctor` / ccloud CLI calls).
CAIRN_CLUSTER_NAME=cairn-dev

# AWS region for Bedrock model access (§2 of PLAN.md).
CAIRN_AWS_REGION=us-east-1
CAIRN_S3_BUCKET=cairn-demo-<aws-account-id>

# Dollar threshold above which the agent escalates instead of launching (action 9, ESCALATE).
CAIRN_APPROVAL_USD=0.50

# conservative (default, judged) | balanced (documented, opt-in, not used in demo)
CAIRN_MODE=conservative
