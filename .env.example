# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# Every variable below is read from the process environment; nothing in this
# repository is expected to contain a live credential.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# CockroachDB connection string. Written by scripts/provision_cluster.sh after
# `ccloud cluster create`, or printed by `./scripts/local_cluster.sh up`.
CAIRN_DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/cairn?sslmode=verify-full

# ---------------------------------------------------------------------------
# AWS — needed for artifact storage, Bedrock embeddings, and remote execution
# ---------------------------------------------------------------------------

# Region used for Bedrock (embeddings + classification) and the default worker
# region when ccloud topology does not authorize one.
CAIRN_AWS_REGION=us-east-1

# Bucket holding content-addressed blobs (`cas/sha256/<digest>`) and fragments.
CAIRN_S3_BUCKET=

# Account id used only to build ECR/ECS ARNs locally. Leave blank to let the
# AWS SDK resolve it from the ambient credential.
CAIRN_AWS_ACCOUNT_ID=

# Set to 1 to run the deterministic-only path: no Bedrock calls, no embeddings,
# no LLM classification. Structural and probe authority are unaffected.
CAIRN_NO_LLM=

# ---------------------------------------------------------------------------
# CockroachDB Cloud identity — used by `cairn doctor` and ECS region routing
# ---------------------------------------------------------------------------

CAIRN_CLUSTER_NAME=cairn-dev

# Reject an ECS routing decision that the ccloud topology cannot authorize,
# instead of falling back. Set to 1 in CI/production.
CAIRN_REQUIRE_CCLOUD_ROUTING=

# Maximum age, in seconds, of a cached `ccloud cluster info` topology.
CAIRN_TOPOLOGY_MAX_AGE_SECONDS=

# ---------------------------------------------------------------------------
# Remote execution (`cairn exec --remote ecs`)
# ---------------------------------------------------------------------------

CAIRN_ECS_CLUSTER=
CAIRN_ECS_TASK_FAMILY=
CAIRN_TASK_DEF=
CAIRN_SUBNETS=
CAIRN_SECURITY_GROUPS=

# Full immutable OCI ref (REPO@sha256:HEX) shared by local, CI, and ECS.
CAIRN_IMAGE_DIGEST=

# Region this worker reports when it takes a claim.
CAIRN_WORKER_REGION=

# ---------------------------------------------------------------------------
# Console — Memory Inspector via the CockroachDB Cloud MCP Server
# ---------------------------------------------------------------------------

CAIRN_MCP_URL=
CAIRN_MCP_API_KEY=
CAIRN_MCP_CLUSTER_ID=

# ---------------------------------------------------------------------------
# Agent loop
# ---------------------------------------------------------------------------

# Dollar threshold above which the agent escalates instead of launching.
# Also settable per invocation with `cairn run --approval-usd`.
CAIRN_APPROVAL_USD=0.50
